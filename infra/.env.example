# Copy this file to apps/api/.env and fill in the values.

# Database
DATABASE_URL=postgresql+asyncpg://ceca:ceca@localhost:5432/ceca

# Redis
REDIS_URL=redis://localhost:6379/0

# AI providers
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
VOYAGE_API_KEY=

# Adapter selection
LLM_PROVIDER=groq
MAM_PROVIDER=mock
STORAGE_PROVIDER=local
STT_PROVIDER=whisper_api
TTS_PROVIDER=elevenlabs
VECTOR_PROVIDER=mock

# Cloudflare R2 (only needed when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Observability
COST_ALERT_THRESHOLD_USD=10.0
